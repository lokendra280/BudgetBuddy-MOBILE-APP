<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/drawable/widget_background.xml
     Rounded-rect background for add_expense_widget.xml. Swap the two
     gradient colors for your actual brand primary/secondary if these
     don't match — AppColors.primaryColor from your Flutter theme is a
     good starting point for android:startColor. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp"/>
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#3373F2"
        android:endColor="#1F4FCC"/>
</shape>